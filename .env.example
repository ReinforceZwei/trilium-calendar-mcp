# Copy to .env and fill in. Every variable is optional except the four marked (required).

# ── Trilium ───────────────────────────────────────────────────────────────────
# (required) Base URL of the Trilium instance, no /etapi suffix.
TRILIUM_URL=https://trilium.example.com
# (required) ETAPI token: Trilium -> Options -> ETAPI -> Create new token.
TRILIUM_ETAPI_TOKEN=

# (required) Calendars to expose, as "noteId" or "noteId:Name" pairs.
# The note id is the Trilium note that acts as the calendar (a collection note
# whose children carry #startDate). Find it in Trilium's "Note info" / from the
# URL (/note/<noteId>). The name is what the agent says: "Gaming" -> :Gaming.
# Without a name, the note's own title is used.
TRILIUM_CALENDARS=0hq1wCTuDBjA:Gaming

# Timezone used for naive datetimes and for rendering results.
TRILIUM_TIMEZONE=Asia/Shanghai

# Set to false only for a self-signed certificate, or point TRILIUM_CA_BUNDLE at a CA.
TRILIUM_VERIFY_SSL=true
# TRILIUM_CA_BUNDLE=/etc/ssl/certs/my-ca.pem
TRILIUM_TIMEOUT=30
TRILIUM_SEARCH_LIMIT=5000

# ── MCP transport ─────────────────────────────────────────────────────────────
# stdio for a local client, streamable-http for a remote agent infrastructure.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8102
MCP_PATH=/mcp

# Only for HTTP, and only for one situation: the server is bound to a loopback
# address (MCP_HOST=127.0.0.1) but reached under a different name, e.g. through
# a reverse proxy on the host. Binding 0.0.0.0 needs no allowlist: the
# DNS-rebinding check is then off, since a container/proxy terminates requests
# under names the server cannot guess.
# MCP_ALLOWED_HOSTS=cal-mcp.internal:443,trilium-calendar-mcp:8102
# MCP_ALLOWED_ORIGINS=https://cal-mcp.internal

LOG_LEVEL=INFO
